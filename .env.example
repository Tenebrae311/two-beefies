# =============================================================================
# two-beefies configuration. Copy to .env and fill in; .env is gitignored.
#   [REQUIRED]  must be set before anything with an agent runs
#   [TEAM]      needed for the real pipeline; ask team 1 / the organizers
#   [DEFAULT]   works as-is, change only if needed
# =============================================================================

# --- 1. Agent LLM: Nemotron 3.5 Super VL on Nebius Token Factory -------------
# [REQUIRED] API key from https://tokenfactory.nebius.com (account -> API keys).
# Also the fixture builder's OCR fallback (Nemotron VL) when no Parse key/URL is set.
NEBIUS_API_KEY=
# [DEFAULT]
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
AGENT_MODEL=nvidia/Nemotron-3.5-Super-VL

# --- 2. Document parsing: Nemotron Parse -------------------------------------
# [REQUIRED for OCR] NVIDIA API key (build.nvidia.com) for the hosted Nemotron Parse
# endpoint. Used by src/batch_nemotron_parse.py and scripts/build_fixture.py.
# Empty -> the fixture builder falls back to Nemotron VL (NEBIUS_API_KEY), then Tesseract.
NVIDIA_API_KEY=
# [TEAM] Only if the organizers' shared endpoint is used instead of NVIDIA's hosted one:
# its chat-completions URL (e.g. https://<host>/v1/chat/completions) and key.
PARSE_URL=
PARSE_API_KEY=
# [DEFAULT]
PARSE_MODEL=nvidia/nemotron-parse

# --- 3. Embeddings + reranking: Nemotron NIM containers on Nebius AI Cloud ---
# [TEAM] Base URLs of the containers team 1 deploys, e.g. http://<vm-ip>:8000
# (we call <EMBED_URL>/v1/embeddings and <RERANK_URL>/v1/ranking).
# Empty EMBED_URL -> LanceDB full-text search; empty RERANK_URL -> no reranking.
EMBED_URL=
RERANK_URL=
# [TEAM] only if the containers sit behind an auth proxy
NIM_API_KEY=
# [DEFAULT] must match the deployed models (curl <EMBED_URL>/v1/models) and the
# model team 1 used for indexing; vector size is EMBED_DIM in two_beefies/schema.py
EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2
RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2

# --- 4. Vector database: LanceDB ---------------------------------------------
# [DEFAULT] ./lancedb holds the dev fixture (scripts/build_fixture.py).
# [TEAM] point to team 1's database once it exists (local path or remote URI).
LANCEDB_URI=./lancedb
# [DEFAULT] table names agreed with team 1 (see two_beefies/schema.py)
BRITANNICA_TABLE=britannica_chunks
WIKIPEDIA_TABLE=wikipedia_chunks
MATCHES_TABLE=matches

