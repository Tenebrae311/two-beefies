# Nebius Token Factory (agent LLM)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
AGENT_MODEL=nvidia/Nemotron-3.5-Super-VL

# Nemotron embedding / reranking NIM containers (deployed on Nebius AI Cloud by team 1)
# Leave EMBED_URL empty to fall back to LanceDB full-text search.
EMBED_URL=
EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2
RERANK_URL=
RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2
NIM_API_KEY=

# LanceDB (local path or remote URI) + table names (contract with team 1)
LANCEDB_URI=./lancedb
BRITANNICA_TABLE=britannica_chunks
WIKIPEDIA_TABLE=wikipedia_chunks
MATCHES_TABLE=matches
