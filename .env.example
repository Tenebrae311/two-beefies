# =============================================================================
# two-beefies configuration. Copy to .env and fill in; .env is gitignored.
#   [REQUIRED]  must be set before anything with an agent runs
#   [TEAM]      needed for the real pipeline; shared by the team / the organizers
#   [DEFAULT]   works as-is, change only if needed
# =============================================================================

# --- 1. Agent LLM: Nemotron 3.5 Super VL on Nebius Token Factory -------------
# [REQUIRED] API key from https://tokenfactory.nebius.com (account -> API keys).
# Used by the Hermes agents, the LLM-guided Wikipedia shortlist and the vision tools.
NEBIUS_API_KEY=
# [DEFAULT]
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
AGENT_MODEL=nvidia/Nemotron-3.5-Super-VL

# --- 2. Document parsing: Nemotron Parse (organizers' shared endpoint) -------
# [TEAM] Full /v1/chat/completions URL of the shared parser (PARSE_URL is an alias).
# Tunnel URLs can change when the organizers redeploy.
PARSE_API_URL=
# [TEAM] Only if the parser requires a key. NEBIUS_API_KEY is never forwarded to it.
PARSE_API_KEY=
# [DEFAULT] Exact id from <parser>/v1/models.
PARSE_MODEL=nvidia/nemotron-3.5-parse
# [OPTIONAL] Fallback: NVIDIA's hosted Parse (build.nvidia.com key) when PARSE_API_URL is
# empty; then set PARSE_MODEL=nvidia/nemotron-parse. Without either, the fixture builder
# falls back to Nemotron VL, then Tesseract.
NVIDIA_API_KEY=

# --- 3. Embeddings + reranking: organizers' model service on a Nebius GPU VM ----
# [TEAM] One service serves both models (organizers' Docker recipe). It binds to
# 127.0.0.1:8000 on the VM; reach it through an SSH tunnel:
#   ssh -N -L 8000:127.0.0.1:8000 <user>@<vm-ip>
# then RETRIEVAL_BASE_URL=http://127.0.0.1:8000/v1
# Empty -> agents use LanceDB full-text search without reranking or evidence scores;
# the ingestion pipeline (src/) refuses to run, because it never stores placeholder vectors.
# (EMBED_URL is accepted as an older name for this setting.)
RETRIEVAL_BASE_URL=
# [TEAM] Only if an HTTPS proxy with a Bearer token sits in front of the service
# (NIM_API_KEY is accepted as an older name).
RETRIEVAL_API_KEY=
# [DEFAULT] Fixed model ids of the service (curl <RETRIEVAL_BASE_URL>/models).
EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2
RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2
# [OPTIONAL] Open-source fallback while the Nemotron deployment is unavailable:
#   RETRIEVAL_BASE_URL=https://api.tokenfactory.nebius.com/v1
#   EMBED_MODEL=Qwen/Qwen3-Embedding-8B
# Uses NEBIUS_API_KEY and requests genuine 2048-d vectors (also for queries). Tables reject
# mixed models: use fresh chunk/match table names when switching back to Nemotron.

# --- 4. Vector database: LanceDB ---------------------------------------------
# [DEFAULT] Local paths are resolved relative to the repository; remote URIs also work.
# ./lancedb holds the dev fixture until the ingestion pipeline has written the real index.
LANCEDB_URI=./lancedb
BRITANNICA_TABLE=britannica_chunks
BRITANNICA_PAGES_TABLE=britannica_pages
WIKIPEDIA_TABLE=wikipedia_chunks
MATCHES_TABLE=matches

# --- 5. LLM-guided Wikipedia shortlist (ingestion pipeline) -------------------
# [DEFAULT]
WIKI_ANALYSIS_MODEL=nvidia/Nemotron-3.5-Super-VL
WIKI_INDEX_PATH=./.data/wikipedia_en.sqlite
WIKI_CANDIDATES_TABLE=wikipedia_candidates
