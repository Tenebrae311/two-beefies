# Nebius Token Factory (agent LLM; Parse only when using Token Factory)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
AGENT_MODEL=nvidia/Nemotron-3.5-Super-VL

# Nemotron embedding / reranking NIM containers (base URL or full endpoint URL)
# Required for the ingestion pipeline; no zero-vector fallback.
EMBED_URL=
EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2
RERANK_URL=
RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2
# Optional explicit NIM key. The official HTTPS api.tokenfactory.nebius.com
# endpoint otherwise uses NEBIUS_API_KEY; dedicated/tunnel URLs do not.
NIM_API_KEY=

# Nemotron Parse: exact model ID reported by the dedicated parser's /v1/models.
PARSE_MODEL=nvidia/nemotron-3.5-parse
# Full /v1/chat/completions URL of the dedicated parser.
# Empty uses NEBIUS_BASE_URL + /chat/completions with NEBIUS_API_KEY.
PARSE_API_URL=
# Optional key for a dedicated parser. Leave empty for an unauthenticated endpoint.
# NEBIUS_API_KEY is never sent to a dedicated PARSE_API_URL.
PARSE_API_KEY=

# LanceDB
LANCEDB_URI=./lancedb
BRITANNICA_TABLE=britannica_chunks
BRITANNICA_PAGES_TABLE=britannica_pages
WIKIPEDIA_TABLE=wikipedia_chunks
MATCHES_TABLE=matches

# LLM-guided Wikipedia shortlist (up to 50 articles per parsed page)
WIKI_ANALYSIS_MODEL=nvidia/Nemotron-3.5-Super-VL
WIKI_INDEX_PATH=./.data/wikipedia_en.sqlite
WIKI_CANDIDATES_TABLE=wikipedia_candidates

