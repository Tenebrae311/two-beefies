# =============================================================================
# two-beefies configuration. Copy to .env and fill in; .env is gitignored.
# =============================================================================

# --- 1. Agent LLM and page understanding: Nebius Token Factory ----------------
# Required for agents and the LLM-guided Wikipedia shortlist.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
AGENT_MODEL=nvidia/Nemotron-3.5-Super-VL

# --- 2. Document parsing: Nemotron Parse --------------------------------------
# Dedicated parser: full /v1/chat/completions URL. PARSE_URL is a legacy alias.
# The pipeline and fixture builder both accept PARSE_API_URL.
PARSE_API_URL=
PARSE_URL=
# Optional dedicated-parser key. Never automatically forwards NEBIUS_API_KEY.
PARSE_API_KEY=
# Use the exact ID from the parser's /v1/models.
PARSE_MODEL=nvidia/nemotron-3.5-parse
# Optional hosted NVIDIA backend for the fixture and standalone parser.
# Set PARSE_MODEL=nvidia/nemotron-parse when using that hosted model.
NVIDIA_API_KEY=
# With no dedicated URL or NVIDIA key, the standalone pipeline uses
# NEBIUS_BASE_URL + /chat/completions and NEBIUS_API_KEY.
# The fixture builder can fall back to Nemotron VL, then Tesseract.

# --- 3. Embeddings + reranking: Nemotron NIM containers on Nebius AI Cloud -----
# Base URLs or full API endpoints. Must match deployed models and EMBED_DIM.
# The ingestion/embedding pipeline requires a real EMBED_URL; no zero vectors.
# Retrieval alone can use full-text search when EMBED_URL is empty.
EMBED_URL=
RERANK_URL=
EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2
RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2
# Optional explicit NIM key. The official HTTPS api.tokenfactory.nebius.com
# endpoint otherwise uses NEBIUS_API_KEY; dedicated/tunnel URLs do not.
NIM_API_KEY=

# --- 4. LanceDB --------------------------------------------------------------
# Local paths are resolved relative to the repository. Remote URIs also work.
LANCEDB_URI=./lancedb
BRITANNICA_TABLE=britannica_chunks
BRITANNICA_PAGES_TABLE=britannica_pages
WIKIPEDIA_TABLE=wikipedia_chunks
MATCHES_TABLE=matches

# --- 5. LLM-guided Wikipedia shortlist ---------------------------------------
WIKI_ANALYSIS_MODEL=nvidia/Nemotron-3.5-Super-VL
WIKI_INDEX_PATH=./.data/wikipedia_en.sqlite
WIKI_CANDIDATES_TABLE=wikipedia_candidates
